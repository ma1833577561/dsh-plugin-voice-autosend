{
  "name": "dsh-plugin-voice-autosend",
  "version": "0.1.0",
  "description": "Voice input for the DeepSeek Harness composer: speak, transcribe locally with SenseVoice, and send the message automatically.",
  "icon": "./icon.png",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "icon.png",
    "screenshots.json",
    "docs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "voice",
    "speech",
    "dictation",
    "speech-to-text",
    "sensevoice"
  ],
  "license": "MIT",
  "author": "ma1833577561",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ma1833577561/dsh-plugin-voice-autosend.git"
  },
  "bugs": {
    "url": "https://github.com/ma1833577561/dsh-plugin-voice-autosend/issues"
  },
  "homepage": "https://github.com/ma1833577561/dsh-plugin-voice-autosend#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-experimental-speech-to-text": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-experimental-speech-to-text-sensevoice": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-experimental-api-speech-to-text": ">=0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-experimental-speech-to-text": {
      "optional": true
    },
    "@deepseek-ai/dsh-experimental-speech-to-text-sensevoice": {
      "optional": true
    },
    "@deepseek-ai/dsh-experimental-api-speech-to-text": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "external": [
        "@deepseek-ai/dsh-api-gateway/client"
      ]
    }
  }
}
